# Firebase config (get from Firebase Console → Project Settings → Web app)
#
# These are NOT secrets. A Firebase web config is designed to ship in the client
# bundle. User data is protected by the security rules in this repo
# (database.rules.json, firestore.rules, storage.rules) — never by hiding these.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=dailybibleverseapp-e3dc5.firebaseapp.com
VITE_FIREBASE_DB_URL=https://dailybibleverseapp-e3dc5-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=dailybibleverseapp-e3dc5
VITE_FIREBASE_STORAGE_BUCKET=dailybibleverseapp-e3dc5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=535654702405
VITE_FIREBASE_APP_ID=your_web_app_id_here

# ── Site identity ───────────────────────────────────────────────────────────
# Canonical origin + path, no trailing slash. Drives canonical URLs, the sitemap,
# robots.txt, llms.txt and structured data. Must match the domain you connect in
# AdSense — Google does not approve sites on commonly-used free hosts like
# *.github.io, so set this to the custom domain before applying.
VITE_SITE_URL=https://ravin7990.github.io/daily-bible-verse

# Public base path. '/' on a custom domain; '/<repo>/' on GitHub Pages.
VITE_BASE_PATH=/daily-bible-verse/

# ── Monetisation ────────────────────────────────────────────────────────────
# ca-pub-XXXXXXXXXX from AdSense → Account → Settings → Account information.
# Leave empty until the account is approved: the ad script and the verification
# meta tag stay out of the document entirely while it is unset.
VITE_ADSENSE_CLIENT=

# ── Contact ─────────────────────────────────────────────────────────────────
VITE_CONTACT_EMAIL=contact@bibleverseoftheday.app

# Optional Formspree-style endpoint for the contact form. Without it the form
# falls back to a mailto: link, so the page is never a dead end.
VITE_CONTACT_FORM=
