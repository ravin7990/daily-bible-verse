rules_version = '2';

// Cloud Storage rules.
//
// Every upload path is namespaced by uid. Nothing may be listed publicly, which
// matters because verse wallpapers and studio creations are user-generated: a
// world-readable bucket lets anyone enumerate and hotlink every upload, and
// makes it easy to publish material you never intended to expose.
service firebase.storage {
  match /b/{bucket}/o {

    // Daily verse wallpapers and assets, read-only for clients.
    // Writes should only come from server/admin functions or the Firebase Console.
    match /daily_backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /imagebackground/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User uploads (verse images, studio creations) live under the author's uid.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Anything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}